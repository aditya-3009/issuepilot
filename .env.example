# SQLite default. For PostgreSQL, use a URL like:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/issuepilot
DATABASE_URL=sqlite:///./issuepilot.db

# Optional: token improves authenticated GitHub API limits. Keep it secret.
GITHUB_TOKEN=

# Optional RAG answer generation. Any OpenAI-compatible chat-completions API works.
# Keep the API key private and never commit a real .env file.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
